# ============================================================================
#  Variáveis usadas pelo docker-compose.yml (produção).
#  Copie para `.env` na raiz do projeto:  cp .env.deploy.example .env
#  Os segredos do back-end continuam em back-end/.env (lido via env_file).
# ============================================================================

# --- Postgres do container (banco da INTRANET) ---
# Devem bater com DB_USER / DB_PASSWORD / DB_NAME do back-end/.env.
DB_USER=postgres
DB_PASSWORD=troque_esta_senha
DB_NAME=postgres

# --- URL pública do servidor (usada pelo back-end: OAuth redirect e FRONTEND_URL) ---
# Usamos um hostname sslip.io (resolve pro IP automaticamente) para viabilizar o
# login Google, que exige HTTPS + domínio (não aceita IP puro nem HTTP).
SERVER_URL=https://192.168.0.145.sslip.io

# --- Build do front-end (assado no bundle em tempo de build) ---
VITE_API_BASE_URL=https://192.168.0.145.sslip.io
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=https://192.168.0.145.sslip.io
VITE_GOOGLE_SCOPE=openid email profile https://www.googleapis.com/auth/calendar https://www.googleapis.com/auth/tasks
VITE_CORPORATE_DOMAIN=bluepaysolutions.com.br
VITE_POWERBI_EMBED_URL=
