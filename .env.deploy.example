# ============================================================================
#  Variáveis usadas pelo docker-compose.yml (produção).
#  Copie para `.env` na raiz do projeto:  cp .env.deploy.example .env
#  e preencha os valores. Este arquivo NÃO contém segredos do back-end —
#  esses continuam em back-end/.env (que o compose lê via env_file).
# ============================================================================

# --- Postgres do container (banco da INTRANET) ---
# Devem bater com DB_USER / DB_PASSWORD / DB_NAME do back-end/.env.
DB_USER=dev_intranet
DB_PASSWORD=troque_esta_senha
DB_NAME=intranet_dev

# --- Build do front-end (assado no bundle em tempo de build) ---
# IMPORTANTE: use a URL PÚBLICA do servidor (IP ou hostname), não localhost,
# pois o front monta URLs absolutas de imagens/socket a partir dela.
VITE_API_BASE_URL=http://IP_DO_SERVIDOR
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=http://IP_DO_SERVIDOR
VITE_GOOGLE_SCOPE=openid email profile https://www.googleapis.com/auth/calendar https://www.googleapis.com/auth/tasks
VITE_CORPORATE_DOMAIN=bluepaysolutions.com.br
VITE_POWERBI_EMBED_URL=
