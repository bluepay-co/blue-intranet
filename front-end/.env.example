# Backend
VITE_API_BASE_URL=http://localhost:5000

# Google Workspace OAuth2 (mesmo Client ID do back-end)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173
VITE_GOOGLE_SCOPE=openid email profile https://www.googleapis.com/auth/calendar https://www.googleapis.com/auth/tasks

# Domínio corporativo (sem o @) — restringe a tela de consentimento ao Workspace
VITE_CORPORATE_DOMAIN=
