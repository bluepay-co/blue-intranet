{
  "title": "PostgreSQL — Bancos de Dados",
  "uid": "blue-postgres",
  "schemaVersion": 39,
  "editable": true,
  "tags": ["blue-intranet", "postgresql", "database"],
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "15s",
  "panels": [
    {
      "id": 100,
      "title": "⚠️ BANCO DE PRODUÇÃO",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 1,
      "title": "Produção — Status",
      "description": "O banco bluepay3_production está respondendo? VERMELHO = CAIU",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 5, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "pg_up{job=\"postgres-producao\"}",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "🔴 FORA DO AR", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "🟢 ONLINE", "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Produção — Tempo de resposta",
      "description": "Latência da conexão com o banco de produção. Se subir, algo está errado.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 5, "x": 5, "y": 1 },
      "targets": [
        {
          "expr": "pg_scrape_duration_seconds{job=\"postgres-producao\"}",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "orange", "value": 3 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Produção — Tamanho",
      "description": "Tamanho total do banco bluepay3_production",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 4, "x": 10, "y": 1 },
      "targets": [
        {
          "expr": "pg_database_size_bytes{job=\"postgres-producao\", datname=\"bluepay3_production\"}",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Produção — Conexões",
      "description": "Conexões abertas no banco de produção (visíveis com a permissão atual)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 4, "x": 14, "y": 1 },
      "targets": [
        {
          "expr": "pg_stat_database_numbackends{job=\"postgres-producao\", datname=\"bluepay3_production\"}",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 20 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Produção — Cache Hit Ratio",
      "description": "Eficiência do cache do Postgres. Abaixo de 90% = muitas leituras em disco = lento",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "expr": "pg_stat_database_blks_hit{job=\"postgres-producao\", datname=\"bluepay3_production\"} / (pg_stat_database_blks_hit{job=\"postgres-producao\", datname=\"bluepay3_production\"} + pg_stat_database_blks_read{job=\"postgres-producao\", datname=\"bluepay3_production\"}) * 100",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 80 },
              { "color": "yellow", "value": 90 },
              { "color": "green", "value": 95 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Produção — Histórico UP/DOWN",
      "description": "Timeline de disponibilidade do banco. Gaps ou quedas pra 0 = banco caiu",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 7 },
      "targets": [
        {
          "expr": "pg_up{job=\"postgres-producao\"}",
          "legendFormat": "bluepay3_production",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "decimals": 0,
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN" } } },
            { "type": "value", "options": { "1": { "text": "UP" } } }
          ],
          "color": { "mode": "fixed", "fixedColor": "green" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 30,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": { "mode": "area" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Produção — Transactions/s",
      "description": "Commits e rollbacks por segundo no banco de produção",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 7 },
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit{job=\"postgres-producao\", datname=\"bluepay3_production\"}[5m])",
          "legendFormat": "Commits/s",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_xact_rollback{job=\"postgres-producao\", datname=\"bluepay3_production\"}[5m])",
          "legendFormat": "Rollbacks/s",
          "refId": "B"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Commits/s" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Rollbacks/s" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      }
    },
    {
      "id": 8,
      "title": "Produção — Erros de conexão/timeout no Backend",
      "description": "Logs do Express com erros de conexão ao banco de produção. Se aparecer linhas aqui, o banco está com problema.",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
      "targets": [
        {
          "expr": "{service=\"backend\"} |~ `(?i)(timeout|ECONNREFUSED|connection terminated|statement_timeout|too many clients|remaining connection slots|could not connect|consulta.?pool|bluepay3)`",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 9,
      "title": "Produção — Erros de timeout/conexão por hora",
      "description": "Quantidade de erros de banco nos logs do backend ao longo do tempo. Picos = banco com problema.",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 21 },
      "targets": [
        {
          "expr": "count_over_time({service=\"backend\"} |~ `(?i)(timeout|ECONNREFUSED|connection terminated|statement_timeout|too many clients|remaining connection slots|could not connect)` [$__interval])",
          "legendFormat": "Erros de conexão/timeout",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 200,
      "title": "BANCO LOCAL (Intranet)",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "collapsed": false
    },
    {
