            { "type": "value", "options": { "0": { "text": "🔴 FORA DO AR", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "🟢 ONLINE", "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Local — Tamanho",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 28 },
      "targets": [
        {
          "expr": "pg_database_size_bytes{job=\"postgres-local\", datname=\"postgres\"}",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "Local — Conexões",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 28 },
      "targets": [
        {
          "expr": "pg_stat_database_numbackends{job=\"postgres-local\", datname=\"postgres\"}",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 8 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "title": "Local — Cache Hit Ratio",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 28 },
      "targets": [
        {
          "expr": "pg_stat_database_blks_hit{job=\"postgres-local\", datname=\"postgres\"} / (pg_stat_database_blks_hit{job=\"postgres-local\", datname=\"postgres\"} + pg_stat_database_blks_read{job=\"postgres-local\", datname=\"postgres\"}) * 100",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
