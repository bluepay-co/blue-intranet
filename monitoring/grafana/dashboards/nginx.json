{
  "title": "API & Tráfego",
  "uid": "blue-nginx",
  "schemaVersion": 39,
  "editable": true,
  "tags": ["blue-intranet", "nginx", "api"],
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "IPs ativos (5min)",
      "description": "Quantas pessoas estão usando a intranet agora (IPs únicos nos últimos 5 minutos)",
      "type": "stat",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 5, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "count(sum by (remote_addr) (count_over_time({service=\"frontend\"} | json | __error__=\"\" [5m])))",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "purple", "value": null }]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Requests/s",
      "description": "Requisições por segundo na API",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 5, "x": 5, "y": 0 },
      "targets": [
        {
          "expr": "rate(nginx_http_requests_total{job=\"nginx\"}[5m])",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Erros (4xx + 5xx)",
      "description": "Requisições que falharam na última hora",
      "type": "stat",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 5, "x": 10, "y": 0 },
      "targets": [
        {
          "expr": "sum(count_over_time({service=\"frontend\"} | json | __error__=\"\" | status >= 400 [$__range]))",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Tempo médio de resposta",
      "description": "Latência média das requisições",
      "type": "stat",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 5, "x": 15, "y": 0 },
      "targets": [
        {
          "expr": "avg_over_time({service=\"frontend\"} | json | __error__=\"\" | unwrap request_time [$__range])",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Erros 5xx",
      "description": "Erros internos do servidor — se aparecer, algo quebrou",
      "type": "stat",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 0 },
      "targets": [
        {
          "expr": "sum(count_over_time({service=\"frontend\"} | json | __error__=\"\" | status >= 500 [$__range]))",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "IPs ativos agora",
      "description": "Quem está usando a intranet — IPs com requisições nos últimos 5 minutos",
      "type": "table",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 5 },
      "targets": [
        {
          "expr": "topk(20, sum by (remote_addr) (count_over_time({service=\"frontend\"} | json | __error__=\"\" [5m])))",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Requisições (5min)", "desc": true }]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": { "remote_addr": "IP", "Value": "Requisições (5min)" }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Requisições (5min)" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "transparent", "value": null }, { "color": "blue", "value": 10 }] } }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "title": "Top rotas mais acessadas",
      "description": "Endpoints /api/* com mais requisições no período",
      "type": "table",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 9, "w": 8, "x": 8, "y": 5 },
      "targets": [
        {
          "expr": "topk(15, sum by (request_uri) (count_over_time({service=\"frontend\"} | json | __error__=\"\" | request_uri=~\"/api/.*\" [$__range])))",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Requisições", "desc": true }]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": { "request_uri": "Rota", "Value": "Requisições" }
          }
        }
      ]
    },
    {
      "id": 8,
      "title": "Requisições lentas (> 1s)",
      "description": "Requisições que demoraram mais de 1 segundo para responder",
      "type": "table",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 5 },
      "targets": [
        {
          "expr": "{service=\"frontend\"} | json | __error__=\"\" | request_time > 1 | line_format \"{{.remote_addr}} | {{.request_method}} {{.request_uri}} | {{.status}} | {{.request_time}}s\"",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Status codes ao longo do tempo",
      "description": "Distribuição de respostas HTTP — verde=sucesso, amarelo=client error, vermelho=server error",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "sum by (status) (count_over_time({service=\"frontend\"} | json | __error__=\"\" [$__interval]))",
          "legendFormat": "HTTP {{status}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
            "stacking": { "mode": "normal" },
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "HTTP 2.." },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "HTTP 3.." },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "HTTP 4.." },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "HTTP 5.." },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      }
    },
    {
      "id": 10,
      "title": "Requests por IP ao longo do tempo",
      "description": "Volume de requisições de cada IP — detecta se um IP está fazendo muitas requisições",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "expr": "sum by (remote_addr) (count_over_time({service=\"frontend\"} | json | __error__=\"\" [$__interval]))",
          "legendFormat": "{{remote_addr}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"], "sortBy": "Total", "sortDesc": true }
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
            "stacking": { "mode": "normal" },
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Requisições com erro (4xx + 5xx)",
      "description": "Cada requisição que retornou erro — com IP, rota, status e tempo",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "targets": [
        {
          "expr": "{service=\"frontend\"} | json | __error__=\"\" | status >= 400 | line_format \"{{.remote_addr}} | {{.request_method}} {{.request_uri}} | {{.status}} | {{.request_time}}s\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ],
  "annotations": { "list": [] },
  "links": [],
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "version": 0
}
