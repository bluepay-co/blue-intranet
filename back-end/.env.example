# Servidor
PORT=5000

# Banco de Dados (PostgreSQL local — banco isolado intranet_dev)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=intranet_dev
DB_USER=dev_intranet
DB_PASSWORD=

# Google Workspace OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173

# Domínio corporativo autorizado (sem o @). Ex: suaempresa.com.br
CORPORATE_DOMAIN=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=8h
