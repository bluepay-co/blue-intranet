# Servidor
PORT=5000

# CORS — lista de origens permitidas, separadas por vírgula (ex.: URL do front
# local + domínio do Vercel). Deixe vazio para refletir qualquer origem (padrão
# atual, sem restrição) — recomendado preencher antes de expor o back-end fora
# da VPN/rede interna.
CORS_ORIGINS=

# Banco de Dados (PostgreSQL local)
# DB_NAME = database; DB_SCHEMA = schema onde fica a tabela usuarios
DB_HOST=localhost
DB_PORT=5432
DB_NAME=intranet_dev
DB_SCHEMA=public
DB_USER=dev_intranet
DB_PASSWORD=

# Google Workspace OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173

# Domínio corporativo autorizado (sem o @). Ex: suaempresa.com.br
CORPORATE_DOMAIN=

# JWT
JWT_SECRET=ap
JWT_EXPIRES_IN=8h

# Chamados — criptografia simétrica das mensagens (AES-256-GCM), 64 hex = 32 bytes.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHAMADOS_ENCRYPTION_KEY=

# URL base do front-end (usada para gerar links nos cards do Slack)
FRONTEND_URL=http://localhost:5173

# ─── Slack — Incoming Webhooks por canal ────────────────────────────────────
# Gere cada URL em: https://api.slack.com/apps → seu app → Incoming Webhooks → Add New Webhook to Workspace
# Adicione uma variável por canal conforme for criando novas integrações.

SLACK_WEBHOOK_CHAMADOS=    # canal #ti-chamados — notificações de novos chamados
SLACK_WEBHOOK_PRODUTOS=    # canal #ti-produtos — notificações de novos produtos

# BluePay Backoffice (API externa de tickets — chamados de infra)
# Token JWT compartilhado; renovar com o time de backend quando expirar.
# ATENÇÃO: a URL abaixo é a de STAGING (.stg.) — em produção, usar a URL de produção
# do Backoffice. Ambas as variáveis são obrigatórias: sem BACKOFFICE_API_URL o
# servidor não sobe, e sem BACKOFFICE_API_TOKEN a rota de chamados retorna 500.
BACKOFFICE_API_URL=https://tickets.stg.blueoffice.tech/api/v1
BACKOFFICE_API_TOKEN=
