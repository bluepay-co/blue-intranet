# Servidor
PORT=5000

# Banco de Dados (PostgreSQL local)
# DB_NAME = database; DB_SCHEMA = schema onde fica a tabela usuarios
DB_HOST=localhost
DB_PORT=5432
DB_NAME=intranet_dev
DB_SCHEMA=public
DB_USER=dev_intranet
DB_PASSWORD=

# Google Workspace OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173

# Domínio corporativo autorizado (sem o @). Ex: suaempresa.com.br
CORPORATE_DOMAIN=

# JWT
JWT_SECRET=ap
JWT_EXPIRES_IN=8h

# Chamados — criptografia simétrica das mensagens (AES-256-GCM), 64 hex = 32 bytes.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHAMADOS_ENCRYPTION_KEY=

# Chat Interno — chave AES-256-GCM independente da de chamados.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHAT_ENCRYPTION_KEY=

# URL base do front-end (usada para gerar links nos cards do Slack)
FRONTEND_URL=http://localhost:5173

# ─── Slack — Incoming Webhooks por canal ────────────────────────────────────
# Gere cada URL em: https://api.slack.com/apps → seu app → Incoming Webhooks → Add New Webhook to Workspace
# Adicione uma variável por canal conforme for criando novas integrações.

SLACK_WEBHOOK_CHAMADOS=    # canal #ti-chamados — notificações de novos chamados
SLACK_WEBHOOK_PRODUTOS=    # canal #ti-produtos — notificações de novos produtos
